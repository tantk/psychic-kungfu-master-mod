<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>JinGuCheats</AssemblyName>
    <RootNamespace>JinGuCheats</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <NoWarn>CS0626;CS0436;CS0108;CS0114;CS0672;NU1701</NoWarn>
    <GameDir>C:\Program Files (x86)\Steam\steamapps\common\JinGu\JinGu</GameDir>
  </PropertyGroup>

  <ItemGroup>
    <!-- MelonLoader (net472 / Mono Unity 2021+) -->
    <Reference Include="MelonLoader">
      <HintPath>$(GameDir)\MelonLoader\net35\MelonLoader.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameDir)\MelonLoader\net35\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Game assemblies -->
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameDir)\JinGu_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(GameDir)\JinGu_Data\Managed\Assembly-CSharp-firstpass.dll</HintPath>
      <Private>false</Private>
    </Reference>

    <!-- Unity engine -->
    <Reference Include="UnityEngine">
      <HintPath>$(GameDir)\JinGu_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameDir)\JinGu_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(GameDir)\JinGu_Data\Managed\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.InputLegacyModule">
      <HintPath>$(GameDir)\JinGu_Data\Managed\UnityEngine.InputLegacyModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(GameDir)\JinGu_Data\Managed\UnityEngine.UI.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.UIModule">
      <HintPath>$(GameDir)\JinGu_Data\Managed\UnityEngine.UIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Copy built plugin into game's Mods folder after every build.
       Also copy the UI exe if it has been built (cargo tauri build). -->
  <Target Name="DeployPlugin" AfterTargets="Build">
    <MakeDir Directories="$(GameDir)\Mods" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(GameDir)\Mods\" />
    <Message Text="Deployed $(AssemblyName).dll to $(GameDir)\Mods\" Importance="high" />

    <PropertyGroup>
      <UiExe>$(MSBuildThisFileDirectory)..\ui\src-tauri\target\release\jingu-cheats-ui.exe</UiExe>
    </PropertyGroup>
    <Copy SourceFiles="$(UiExe)" DestinationFolder="$(GameDir)\Mods\" Condition="Exists('$(UiExe)')" />
    <Message Text="Deployed jingu-cheats-ui.exe to $(GameDir)\Mods\" Importance="high" Condition="Exists('$(UiExe)')" />
    <Warning Text="UI exe not found at $(UiExe). Build it with: cd ../ui &amp;&amp; cargo tauri build --no-bundle" Condition="!Exists('$(UiExe)')" />
  </Target>

</Project>
